{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/cards/**",
              "components/charts/**",
              "components/chrome/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/partnerhub/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityType'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|tone|key|ref|className|style|children)$/]",
        "message": "<ActivityType> doesn't accept that prop. Declared props: label, icon, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityType'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warning|danger|info|success|teal|neutral)$/]",
        "message": "<ActivityType> tone must be one of 'warning' | 'danger' | 'info' | 'success' | 'teal' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: variant, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:validation|destructive|warning|notice|empty)$/]",
        "message": "<Alert> variant must be one of 'validation' | 'destructive' | 'warning' | 'notice' | 'empty'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|right|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: variant, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:teal|blue|dark)$/]",
        "message": "<AppHeader> variant must be one of 'teal' | 'blue' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|size|key|ref|className|style|children)$/]",
        "message": "<AvatarTile> doesn't accept that prop. Declared props: initials, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartSeries'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|color|key|ref|className|style|children)$/]",
        "message": "<ChartSeries> doesn't accept that prop. Declared props: key, label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:dark|size|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: dark, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|children|onClick|style|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, children, onClick, style, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|teal|soft|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'teal' | 'soft' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Column'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|num|key|ref|className|style|children)$/]",
        "message": "<Column> doesn't accept that prop. Declared props: key, label, num."
      },
      {
        "selector": "JSXOpeningElement[name.name='Development'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|address|units|status|key|ref|className|style|children)$/]",
        "message": "<Development> doesn't accept that prop. Declared props: name, address, units, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonutDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|color|key|ref|className|style|children)$/]",
        "message": "<DonutDatum> doesn't accept that prop. Declared props: name, value, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tint|key|ref|className|style|children)$/]",
        "message": "<KpiCard> doesn't accept that prop. Declared props: value, label, tint."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineSeries'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|color|dashed|key|ref|className|style|children)$/]",
        "message": "<LineSeries> doesn't accept that prop. Declared props: key, label, color, dashed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Listbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Listbox> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|footer|children|center|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, onClose, title, footer, children, center."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|state|key|ref|className|style|children)$/]",
        "message": "<TimelineStep> doesn't accept that prop. Declared props: label, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineStep'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|current|pending)$/]",
        "message": "<TimelineStep> state must be one of 'done' | 'current' | 'pending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|key|ref|className|style|children)$/]",
        "message": "<ProfileField> doesn't accept that prop. Declared props: label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickStartAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|sub|key|ref|className|style|children)$/]",
        "message": "<QuickStartAction> doesn't accept that prop. Declared props: icon, label, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='RequiredLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|required|bold|htmlFor|key|ref|className|style|children)$/]",
        "message": "<RequiredLabel> doesn't accept that prop. Declared props: children, required, bold, htmlFor."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segment'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|state|key|ref|className|style|children)$/]",
        "message": "<Segment> doesn't accept that prop. Declared props: value, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segment'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:complete|inProgress)$/]",
        "message": "<Segment> state must be one of 'complete' | 'inProgress'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SideItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|indent|chevron|onClick|key|ref|className|style|children)$/]",
        "message": "<SideItem> doesn't accept that prop. Declared props: icon, label, active, indent, chevron, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SideItem'] > JSXAttribute[name.name='chevron'] > Literal[value!=/^(?:down|right)$/]",
        "message": "<SideItem> chevron must be one of 'down' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Person'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|name|title|dept|branch|email|phone|key|ref|className|style|children)$/]",
        "message": "<Person> doesn't accept that prop. Declared props: initials, name, title, dept, branch, email, phone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|title|sub|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: tone, icon, title, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|gold|blue|teal)$/]",
        "message": "<StatCard> tone must be one of 'red' | 'gold' | 'blue' | 'teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Step'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|state|key|ref|className|style|children)$/]",
        "message": "<Step> doesn't accept that prop. Declared props: label, icon, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='Step'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|current|pending)$/]",
        "message": "<Step> state must be one of 'done' | 'current' | 'pending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='WizardPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|footer|children|key|ref|className|style|children)$/]",
        "message": "<WizardPanel> doesn't accept that prop. Declared props: title, footer, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='WizardPart'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|state|key|ref|className|style|children)$/]",
        "message": "<WizardPart> doesn't accept that prop. Declared props: label, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='WizardPart'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:complete|active|upcoming)$/]",
        "message": "<WizardPart> state must be one of 'complete' | 'active' | 'upcoming'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
